# Copy to .env.agent (gitignored) and fill in. Passed straight into the agent
# container by scripts/run-agent as environment variables — never committed,
# and separate from local.properties, which is Gradle's.
#
# Picovoice console -> AccessKey. Free personal tier, needed by the "Hey Dobby"
# wake word (dobby-plan.md §4).
PICOVOICE_ACCESS_KEY=

# Spotify app credentials for SpotifySock (socks.specs/spotify.specs.md).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
