<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Declared here as well as in :android:pipeline: this is the module that asks the user
         for it at runtime, and a foreground service of type microphone is only legal with it. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- dobby-plan.md §7.1: CPU stays awake with the screen off. The panel is mains-powered.
         Also what Media3's WAKE_MODE_NETWORK needs to keep a stream alive with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- radio.specs.md §1: internet radio streams. No cleartext exception — every station in
         the table is reachable over HTTPS, including Kronehit (radio-plan.md §B3). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- weather.specs.md §1: the forecast is for wherever the panel is standing, so it has to
         be asked once where that is. COARSE and not FINE, deliberately: a forecast grid cell is
         kilometres across, so a fine fix buys nothing and costs the scariest permission dialog
         Android has. Asked for at the Setup button and nowhere else. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- clock.specs.md §3: the AlarmManager backstop behind a running timer. A kitchen timer is
         USE_EXACT_ALARM-class use, so it is granted at install; SCHEDULE_EXACT_ALARM is declared
         alongside it for the user-revocable path, and the Clock Sock degrades if it is denied. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:label="Dobby"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dobby">

        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- clock.specs.md §10: the timer backstop. In the manifest and not registered at
             runtime, because the case it exists for is the one where the process is gone. -->
        <receiver
            android:name=".TimerAlarmReceiver"
            android:exported="false" />

        <service
            android:name=".DobbyService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
